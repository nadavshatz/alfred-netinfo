#!/bin/zsh -f
# Mock curl. Logs argv (one arg per line, then "--") to $MOCK_DIR/curl.log.
#   External IP: prints $MOCK_DIR/ext; exit 28 if $MOCK_DIR/offline exists.
#   GitHub:  HEAD …/releases/latest → 302 to …/tag/v$(<$MOCK_DIR/latest)
#            GET  …/releases/download/vX/FILE → $MOCK_DIR/releases/vX/FILE
setopt extended_glob
print -rl -- "$@" -- >> $MOCK_DIR/curl.log
[[ -e $MOCK_DIR/offline ]] && exit 28
out= url= head=0
while (( $# )); do
  case $1 in
    -o) out=$2; shift ;;
    --proto|--max-time) shift ;;
    -*I*) head=1 ;;
    http*) url=$1 ;;
  esac
  shift
done
if [[ $url == */releases/* ]]; then
  if (( head )); then
    [[ $url == */releases/latest ]] || exit 22
    printf 'HTTP/2 302\r\nlocation: https://github.com/nadavshatz/x/releases/tag/v%s\r\n\r\n' "$(<$MOCK_DIR/latest)"
    exit 0
  fi
  [[ $url == (#b)*/releases/download/([^/]##)/([^/]##) ]] || exit 22
  src=$MOCK_DIR/releases/$match[1]/$match[2]
  [[ -f $src ]] || exit 22
  cp -- $src $out; exit 0
fi
[[ -f $MOCK_DIR/ext ]] || exit 22
cat $MOCK_DIR/ext
